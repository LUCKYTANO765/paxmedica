# ============================================================
# CONFIGURACION DEL BOT — Bombas de Dolor Bolivia
# ============================================================
# Copiar este archivo como ".env" y completar con sus valores reales.
# NUNCA subir el archivo .env a GitHub — contiene claves secretas.
# ============================================================

# ------------------------------------------------------------
# Anthropic (Claude AI)
# Obtener en: https://console.anthropic.com/
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_api_key_here

# ------------------------------------------------------------
# Twilio (WhatsApp API)
# Obtener en: https://console.twilio.com/
# Account SID y Auth Token están en la página principal del dashboard
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Número de WhatsApp de Twilio (con prefijo "whatsapp:")
# En sandbox: whatsapp:+14155238886
# En producción: whatsapp:+591XXXXXXXX (tu número de negocio)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ------------------------------------------------------------
# Webhook
# Este token lo inventas tú — úsalo para verificar el webhook en Twilio
# Ejemplo: una palabra secreta como "mi_token_secreto_2024"
# ------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ------------------------------------------------------------
# Servidor
# En Railway, PORT se asigna automáticamente — no cambiar
# ------------------------------------------------------------
PORT=3000
NODE_ENV=production
